{
  "manifest_version": 3,
  "name": "Speech Translator for Meetings (Enterprise)",
  "version": "1.0.0",
  "description": "Enterprise-grade real-time bidirectional speech-to-speech & speech-to-text translator (EN/ID).",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "ws://localhost:8000/*",
    "ws://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Speech Translator Settings"
  },
  "icons": {
    "48": "icons.svg"
  }
}
