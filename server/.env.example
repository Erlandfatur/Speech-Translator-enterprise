# Copy this file to .env and fill in your real keys. DO NOT commit .env.

# Google Gemini (fallback NMT) — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (primary STT Whisper turbo + NMT Llama) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: WebSocket auth token for the translation server.
# When set, clients must connect with ?token=WS_API_TOKEN
WS_API_TOKEN=

# Optional: CORS allowlist (comma-separated) — restrict to your extension origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000

# Optional: Latency tuning (seconds). Lower values flush faster but with less context.
BUFFER_MAX_SEC=8.0
BUFFER_MIN_SEC=1.5
SILENCE_FLUSH_SEC=0.6
GROQ_COOLDOWN_SEC=0.8
BUFFER_TAB_FLUSH_SEC=2.0
