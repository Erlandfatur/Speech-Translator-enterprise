# Copy this file to .env and fill in your real keys. DO NOT commit .env.

# Google Gemini (fallback NMT) — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (primary STT Whisper turbo + NMT Llama) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# Per-user auth (JWT). The server FAILS CLOSED: if AUTH_SECRET is
# empty, no WebSocket is accepted and no tokens are issued.
# ============================================================
# HMAC-SHA256 signing secret — generate a long random value, e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_ISSUER=speech-translator
# Max token lifetime in seconds (default 86400 = 24h; cap 30 days).
AUTH_MAX_TOKEN_TTL=86400

# Admin bearer key for POST /auth/token and /auth/revoke.
# Clients call these endpoints with:  Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=

# Bring-Your-Own-Key: when 'true', authenticated users may supply their OWN
# Groq/Gemini keys per-session (in-memory, never logged). AI cost then bills to
# the user. When 'false' (default), server always uses its own env keys.
BYOK_ENABLED=false

# ============================================================
# Per-user cost & resource controls (cost-abuse mitigation).
# 0 disables the corresponding control.
# ============================================================
# Token-bucket request rate limit (requests allowed per minute, burst capacity).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20
# Monthly usage cap per user (weighted credits; 0 = unlimited).
USER_MONTHLY_CREDITS=0
# Max concurrent connections per user.
MAX_CONNECTIONS_PER_USER=2
# Max inbound WebSocket message size in bytes (default 2 MB).
MAX_WS_MSG_BYTES=2097152
# Max concurrently running STT->NMT->TTS pipelines server-wide.
MAX_CONCURRENT_PIPELINES=4

# Optional: CORS allowlist (comma-separated) — restrict to your extension origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000

# Optional: Latency tuning (seconds). Lower values flush faster but with less context.
BUFFER_MAX_SEC=8.0
BUFFER_MIN_SEC=1.5
SILENCE_FLUSH_SEC=0.6
GROQ_COOLDOWN_SEC=0.8
BUFFER_TAB_FLUSH_SEC=2.0
